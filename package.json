{
  "name": "@eckobrew/homestream-backend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc --noEmit && tsup --format esm --platform node --target node22 --out-dir dist",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mobile": "node --import tsx scripts/test-mobile-api.mjs",
    "test:playback": "node scripts/test-playback-capabilities.mjs",
    "contract:generate": "node --import tsx scripts/generate-contract.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:pack": "tsc -p contract/tsconfig.json && cp contract/paths.d.ts contract/dist/paths.d.ts && npm pack ./contract",
    "test:torrent": "node --import tsx --test integration/torrent.test.ts",
    "storage:import": "node --env-file-if-exists=.env dist/import-state.js",
    "lint": "eslint .",
    "storage:backup": "node --env-file-if-exists=.env dist/backup-state.js",
    "contract:kotlin": "bash scripts/generate-kotlin.sh",
    "contract:test": "node scripts/compare-contract-test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fastify": "^5.6.2",
    "proxy-addr": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/proxy-addr": "^2.0.3",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "typescript-json-schema": "^0.68.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eckobrew/homestream-backend.git"
  },
  "license": "MIT"
}
