            "type": "string"
          },
          "rating": {
            "type": "string"
          },
          "matchPercentage": {
            "type": "number"
          },
          "communityRating": {
            "type": "number"
          },
          "durationMinutes": {
            "type": "number"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seasonsCount": {
            "type": "number"
          },
          "source": {
            "enum": [
              "demo",
              "jellyfin",
              "seerr"
            ],
            "type": "string"
          },
          "jellyfinId": {
            "type": "string"
          },
          "seerrId": {
            "type": "number"
          },
          "tmdbId": {
            "type": "number"
          },
          "playableEpisodeId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AvailabilityStatus"
          },
          "played": {
            "type": "boolean"
          },
          "playbackPositionTicks": {
            "type": "number"
          },
          "totalDurationTicks": {
            "type": "number"
          },
          "progressPercent": {
            "type": "number"
          },
          "cast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CastMember"
            }
